# Copy to .env and fill in. Never commit .env.

# Back team
TWITTERAPI_IO_KEY=
EDUHUB_FAKE_AI=1            # 1 = use eduhub_shared.fakes instead of eduhub_ai (until the AI is ready)
DEMO_MODE=0                 # 1 = serve pre-computed reports for the demo account(s)
FRONTEND_ORIGIN=http://localhost:3000   # comma-separated list of allowed origins
DATABASE_PATH=data/eduhub.sqlite3       # SQLite file for jobs, snapshots and reports
FIXTURES_DIR=src/backend/fixtures       # <handle>.json snapshots and <handle>.report.json reports

# AI team (all optional except the key; defaults in src/ai/docs/plan/README.md)
OPENROUTER_API_KEY=
AI_LABEL_MODEL=deepseek/deepseek-v4.1-flash    # labeling + sandbox (OpenRouter model slug)
AI_WRITER_MODEL=deepseek/deepseek-v4.1-flash   # insights + drafts
AI_FALLBACK_MODELS=         # comma-separated OpenRouter slugs, tried in order if the main model fails
AI_LLM_TIMEOUT_S=30         # per-call timeout, seconds
AI_MAX_CONCURRENCY=8        # max parallel LLM calls
AI_ENABLE_LLM=1             # 0 = template-only mode (no LLM calls)
AI_LABEL_REASONING=off      # off | minimal | low | medium | high | default (labeling needs no thinking)
AI_WRITER_REASONING=low     # same levels, for the insight writer
AI_PROVIDER_SORT=throughput # throughput | latency | price | none (OpenRouter provider routing)
AI_PROVIDERS=               # optional comma-separated provider order, e.g. fireworks,deepinfra

# Front team (in src/frontend/.env.local)
# NEXT_PUBLIC_API_URL=http://localhost:8000
# NEXT_PUBLIC_API_MOCK=1
